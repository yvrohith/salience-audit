    "valid": "Two generated-response validity flags.",
    "format": "Two response-format classifications; all released observations are canonical_json.",
    "finish": "Two termination classifications; all released observations are stop."
  },
  "analysis": {
    "bootstrap": {
      "replicates": 10000,
      "unit": "template",
      "stratify": "domain",
      "old_seed": 2026100601,
      "fresh_seed": 2026100602,
      "shared_within_bank": true,
      "cross_bank_streams_independent": true,
      "quantile": "linear 0.025/0.975",
      "robust_interval": "lower bound draw 0.025 quantile and upper bound draw 0.975 quantile",
      "scope": "conditional on fitted weights and authored banks"
    },
    "canonical_ties": {
      "definition": "exact equality of saved logp_A and logp_B",
      "point_convention": 0.5,
      "bounds": [
        0,
        1
      ],
      "valid_score_record": true,
      "resolved_choice": false
    },
    "missingness": {
      "invalid_choice_bounds": [
        0,
        1
      ],
      "point": "common complete joint templates across all contributing principals, positions, models and readouts",
      "bounds": "all templates; propagate signed cell coefficients before averaging",
      "reweight_available_comparators": false
    },
    "strong_generated_criterion": {
      "readout": "generated",
      "statistics": [
        "target_specificity",
        "target_minus_balanced",
        "target_minus_generic"
      ],
      "point_minimum": 0.2,
      "robust95_lower_strictly_above": 0,
      "arithmetic_guard": 1e-12,
      "implemented_comparisons": "point >=0.2-1e-12 and robust lower >1e-12; generated-only roundoff handling far below attainable resolution; reported values and exact canonical/rank ties unchanged",
      "per_principal_model_valid_fraction_minimum": 0.95,
      "joint_template_completeness_minimum": 0.9,
      "position_validity": "reported; no additional gate",
      "interpretation": "engineering criterion, not a calibrated detector rule"
    },
    "decomposition": {
      "contrasts": [
        "probability_minus_canonical_argmax",
        "canonical_argmax_minus_generated",
        "probability_minus_generated"
      ],
      "exact_additive_decomposition": "only under shared P/C/G complete-template mask",
      "agreement": "resolved canonical choice and valid generated choice; ties and invalids kept separate"
    },
    "ranks": {
      "tie_convention": "all other equal values count ahead",
      "scope": "descriptive",
      "lower": "1 + count(other lower >= target upper)",
      "upper": "1 + count(other upper >= target lower)",
      "refit_correction_to_new_readouts": false
    },
    "readouts": [
      "probability",
      "canonical_argmax",
      "generated"
    ],
    "condition_contrasts": [
      "target_minus_balanced",
      "target_minus_generic"
    ],
    "original_median_mass_threshold": 0.5
  },
  "generation": {
    "temperature": 0,
    "max_tokens": 64,
    "batch_size": 32,
    "prefill_batch_size": 8,
