docs/ORGANIZER_DISCLOSURE.md
docs/REPORT_CONTENT.md

# Duplicate convenience bundle retained locally. The public verification
# records live under artifacts/confirmation_results/.
submission/

# Run outputs: raw completions stay out of git until licensing and disclosure
# review are settled. The sealed aggregate artifacts the report cites are
# committed, so the hash chain can be verified from the repository alone.
#
# Note: git will not descend into an excluded directory, so each level has to be
# re-included before its children can be negated.
runs/
artifacts/*
!artifacts/.gitkeep
!artifacts/confirmation_results/
artifacts/confirmation_results/*
!artifacts/confirmation_results/summary.json
!artifacts/confirmation_results/decision_manifest.json
!artifacts/confirmation_results/control_reveal.json
!artifacts/confirmation_results/base_weight_manifest.json
!artifacts/confirmation_results/complete_robustness.json
!artifacts/confirmation_results/robustness_table.csv
!artifacts/confirmation_results/control_reveal_weight_manifests/
artifacts/confirmation_results/control_reveal_weight_manifests/*
!artifacts/confirmation_results/control_reveal_weight_manifests/*.json
